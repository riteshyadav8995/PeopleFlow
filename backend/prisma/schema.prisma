  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee       Employee @relation("FeedbackReceiver", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer       Employee @relation("FeedbackSender", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId])
  @@map("feedback")
}

// ─── ASSETS ──────────────────────────────────

model Asset {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  name           String
  type           String   // Hardware, Software, Office
  status         String   @default("Available") // Available, Allocated, Under Maintenance, Retired
  serialNumber   String?  @map("serial_number")
  purchaseDate   DateTime? @map("purchase_date")
  cost           Float?
  assignedTo     String?   @map("assigned_to")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee       Employee? @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([organizationId])
  @@map("assets")
}

model AssetRequest {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  organizationId String   @map("organization_id")
  employeeId     String   @map("employee_id")
  assetType      String   @map("asset_type")
  assetName      String   @map("asset_name")
  reason         String   @db.Text
  cost           String?
  status         String   @default("pending") // pending, approved, rejected
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  employee       Employee @relation("EmployeeAssetRequests", fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([organizationId])
  @@index([employeeId])
  @@map("asset_requests")
}
